# Copy to .env (deploy.sh / deploy.ps1 does this and fills in the secrets).
# .env is gitignored.

# --- required ---------------------------------------------------------------
# Passphrase everyone on the team types once when they connect. Claude's
# connector UI performs OAuth and will not accept a bare token, so this is the
# mode to use for a shared deployment.
MCP_TEAM_PASSWORD=

# Qdrant's only access control -- it has no user accounts. Keep the container off
# the public internet regardless.
QDRANT_API_KEY=

# --- public URL -------------------------------------------------------------
# Whatever teammates paste into Claude, without the /mcp suffix. With the `tls`
# compose profile this is https://$DOMAIN; behind a tunnel it is the tunnel's URL.
MCP_PUBLIC_URL=http://localhost:8000

# Only for the `tls` profile: must resolve to this host with ports 80 and 443
# reachable, or Caddy cannot issue a certificate.
DOMAIN=

# --- optional ---------------------------------------------------------------
# Extra hostnames the server accepts a Host header from. It derives this from
# MCP_PUBLIC_URL by default; set it when a proxy rewrites the Host.
MCP_ALLOWED_HOSTS=

# Bearer token for scripted clients and `rag.py doctor --url ... --token ...`.
# Claude's connector UI will NOT accept this mode.
MCP_AUTH_TOKEN=

# 0 drops the cross-encoder reranker: ~3-5x faster on CPU, noticeably worse.
RAG_RERANK=1

# Point the local scripts at a shared Qdrant instead of data/qdrant.
# QDRANT_URL=http://localhost:6333

# For `rag.py chat`.
# ANTHROPIC_API_KEY=
