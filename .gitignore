.venv/
__pycache__/
*.pyc

# original/ is NOT committed: 18 GB of PDFs, 78 of them over GitHub's 100 MB
# per-file hard limit. corpus.json records each document's path under it, so the
# machine that holds the PDFs can always rebuild.
original/

# data/ is NOT committed either, though an earlier plan was to ship it this way.
# Two facts killed that: the index is 2.2 GB (past Git LFS's free tier, and a
# fresh copy would enter history on every rebuild), and at 158k points the
# embedded store answers a query in ~7 s because it has no ANN index -- so even
# if it were shipped, the receiving machine could not serve from it acceptably.
# Move the index with a Qdrant snapshot instead, and serve it from a Qdrant
# server. See HOSTING.md.
data/

# extracted/ holds one text file per document -- 221 MB once the journals were
# added, and regenerable from the PDFs. Only the three textbook extractions are
# kept: one of them is OCR output for a scanned book that cannot be reproduced
# from its PDF, and they are what the cleaning heuristics were tuned against.
extracted/*
!extracted/paul_mtl.txt
!extracted/hall_asi.txt
!extracted/dsi_mod.txt

# secrets: QDRANT_API_KEY, MCP_TEAM_PASSWORD, ANTHROPIC_API_KEY
.env

# runtime noise
*.log
