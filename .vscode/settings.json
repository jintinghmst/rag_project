{
  // Use the project venv, not the system Python 3.10 (which has none of the deps).
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,

  // Code Runner ignores the selected interpreter and shells out to bare `python`,
  // so it needs the venv spelled out separately.
  "code-runner.executorMap": {
    "python": "\"$workspaceRoot\\.venv\\Scripts\\python.exe\" -u \"$fullFileName\""
  },
  // run in the terminal so scripts that print progress or take input behave
  "code-runner.runInTerminal": true,
  "code-runner.fileDirectoryAsCwd": false,
  "code-runner.cwd": "${workspaceFolder}"
}
