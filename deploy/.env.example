# Public hostname for the connector. Must resolve to this host, with ports 80
# and 443 reachable from the internet, or Caddy cannot issue a certificate.
DOMAIN=rag.example.edu

# Shared bearer token teammates' Claude clients present. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Qdrant API key (internal to the compose network, but set it anyway).
QDRANT_API_KEY=

# Set to 0 to drop the cross-encoder reranker: ~3-5x faster on CPU, worse results.
RAG_RERANK=1
